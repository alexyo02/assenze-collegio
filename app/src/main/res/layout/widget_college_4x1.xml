<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_4x1_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingTop="8dp"
    android:paddingRight="12dp"
    android:paddingBottom="8dp">

    <!-- LEFT: PRESENCE % & APP LABEL -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Presenza"
            android:textColor="#64748B"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_4x1_tv_percentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="99.0%"
            android:textColor="#7C3AED"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- DIVIDER -->
    <ImageView
        android:layout_width="1dp"
        android:layout_height="26dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:background="#E2E8F0"
        android:contentDescription="Divisore" />

    <!-- CENTER: ABSENCES & BADGE -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Assenze: "
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_4x1_tv_absences"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 gg"
                android:textColor="#0F172A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="Disp: "
                android:textColor="#64748B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_4x1_tv_available"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-- gg"
                android:textColor="#7C3AED"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- STATUS BADGES -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_4x1_badge_safe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_safe"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:text="Regolare (> 56%)"
                android:textColor="#16A34A"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:visibility="visible" />

            <TextView
                android:id="@+id/widget_4x1_badge_warn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_warn"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:text="Attenzione"
                android:textColor="#D97706"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/widget_4x1_badge_crit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_badge_crit"
                android:paddingLeft="6dp"
                android:paddingTop="2dp"
                android:paddingRight="6dp"
                android:paddingBottom="2dp"
                android:text="Sotto Soglia"
                android:textColor="#DC2626"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- RIGHT: REFRESH / ACTION -->
    <TextView
        android:id="@+id/widget_4x1_btn_refresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_btn_bg"
        android:paddingLeft="8dp"
        android:paddingTop="6dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp"
        android:text="↻"
        android:textColor="#475569"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
